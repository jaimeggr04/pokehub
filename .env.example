# Copia este fichero a .env.local antes de arrancar:
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   macOS / Linux:         cp .env.example .env.local
#
# Los valores salen del panel de Supabase, en Project Settings > API.
# La clave "anon" está pensada para viajar al navegador: no es secreta.
# Lo que protege los datos son las políticas RLS de supabase/migrations.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Sólo en producción: origen público de la app, usado para construir la URL de
# vuelta del acceso con Google y GitHub (/auth/callback) y la de los correos de
# confirmación. En local se deduce de las cabeceras, así que puedes omitirlo.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
